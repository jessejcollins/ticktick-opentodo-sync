# Copy to .env (gitignored) and fill in. Read by compose (env_file) and by `ticktick-opentodo-sync` directly.

# TickTick web -> avatar -> Settings -> Account -> API Token
TICKTICK_TOKEN=

# Your OpenTodo instance and a `full`-scope token (Settings -> Integrations -> API tokens)
OPENTODO_URL=https://todo.example.com
OPENTODO_TOKEN=

# Only if OpenTodo end-to-end encryption is on: set ONE of these. The sync decrypts what it
# reads and encrypts what it writes, like your browser. The recovery key unlocks instantly;
# the passphrase costs a few seconds of CPU once per container start. Wrap in single quotes
# so neither compose nor the parser touches `$`, `#` or spaces.
# OPENTODO_ENCRYPTION_RECOVERY_KEY='XXXX-XXXX-...'
# OPENTODO_ENCRYPTION_PASSPHRASE='...'

# Log what would change without writing anything. Leave true until you've checked a few runs.
TICKTICK_OPENTODO_SYNC_DRY_RUN=true

# A pass that would delete or complete more than this many tasks stops and reports instead.
TICKTICK_OPENTODO_SYNC_MAX_DESTRUCTIVE=10

# Seconds between passes in --loop mode (minimum 60).
TICKTICK_OPENTODO_SYNC_INTERVAL=300

# Zone for all-day dates and floating OpenTodo times. Empty = TickTick account preference.
TICKTICK_OPENTODO_SYNC_TIMEZONE=

# TICKTICK_OPENTODO_SYNC_LOG_LEVEL=INFO
# TICKTICK_OPENTODO_SYNC_HTTP_MIN_INTERVAL=0.3
# TICKTICK_OPENTODO_SYNC_HTTP_TIMEOUT=20
# Outside Docker only (the image sets these to /data and /run/ticktick-opentodo-sync):
# TICKTICK_OPENTODO_SYNC_STATE_DIR=./state
# TICKTICK_OPENTODO_SYNC_RUN_DIR=
